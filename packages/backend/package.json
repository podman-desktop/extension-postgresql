{
  "name": "postgresql",
  "displayName": "PostgreSQL",
  "description": "Manage local PostgreSQL services for development",
  "version": "0.6.0-next",
  "icon": "icon.png",
  "publisher": "podman-desktop",
  "license": "Apache-2.0",
  "engines": {
    "podman-desktop": ">=1.14.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "icons": {
      "pg-icon": {
        "description": "PostgreSQL icon",
        "default": {
          "fontPath": "pg-icon.woff2",
          "fontCharacter": "\\E001"
        }
      }
    },
    "menus": {
      "dashboard/container": [
        {
          "command": "postgresql.pgadmin.start",
          "title": "Start PgAdmin",
          "when": "containerImageName =~ /docker\\.io\\/library\\/postgres/ || containerImageName =~ /docker\\.io\\/pgvector\\/pgvector/"
        }
      ]
    },
    "views": {
      "icons/containersList": [
        {
          "when": "containerImageName =~ /docker\\.io\\/library\\/postgres/ || containerImageName =~ /docker\\.io\\/pgvector\\/pgvector/",
          "icon": "${pg-icon}"
        }
      ]
    },
    "commands": [
      {
        "command": "postgresql.pgadmin.start",
        "title": "PgAdmin: start..."
      }
    ]
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "watch": "vite --mode development build -w"
  },
  "devDependencies": {
    "@podman-desktop/api": "1.30.5",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.5",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "semver": "^7.8.5"
  }
}
